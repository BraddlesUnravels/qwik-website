{
  "name": "qwik-website",
  "version": "0.1.0",
  "description": "Portfolio landing page built with Qwik and Qwik City",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/bun/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "build.container": "docker build -f docker/Dockerfile -t qwik-website:production .",
    "ci": "bun run fmt.check && bun run lint && bun run build.types && bun run test.unit && bun run build && bun run test.ct && bun run test.e2e",
    "cypress.open": "cypress open",
    "cypress.run": "cypress run",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\" \"test/**/*.ts*\"",
    "prepare": "husky",
    "preview": "qwik build preview && vite preview --open",
    "serve": "bun server/entry.bun.js",
    "start": "vite --open --mode ssr",
    "test": "vitest run",
    "test.all": "bun run test.unit && bun run test.ct && bun run test.e2e",
    "test.ct": "cypress run --component",
    "test.ct.open": "cypress open --component",
    "test.e2e": "start-server-and-test dev http://localhost:5173 \"cypress run --e2e\"",
    "test.e2e.open": "start-server-and-test dev http://localhost:5173 \"cypress open --e2e\"",
    "test.unit": "vitest run",
    "test.unit.coverage": "vitest run --coverage",
    "test.unit.ui": "vitest --ui",
    "test.unit.watch": "vitest",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@eslint/js": "^9.39.1",
    "@qwik-ui/headless": "^0.7.7",
    "@tailwindcss/vite": "^4.1.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^5",
    "@vitest/ui": "^5",
    "cypress": "^15",
    "cypress-ct-qwik": "^0.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-qwik": "1.20.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.1",
    "undici": "^6.21.3",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^5"
  },
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0",
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.12"
}

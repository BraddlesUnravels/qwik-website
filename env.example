# Runtime (container / Bun serve)
# Internal container port is always 3000. Map a host port with HOST_PORT.
HOST_PORT=3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Optional local-only origin override for tools that need an absolute base.
# Not required for the first Azure-FQDN deployment and not injected by IaC.
# ORIGIN=http://localhost:3000

# Build-time only (Vite). Omit until a verified canonical domain is chosen.
# When set, rebuild the image so SEO canonical/og:url values are emitted.
# PUBLIC_SITE_URL=https://example.com

# Runtime, server-only. Used by the "Try the live demo" action on
# /work/access-control-demo/ — never exposed to the client bundle.
# The link may reference other vars as {{NAME}} placeholders.
# ACA_DEMO_DOMAIN=https://demo.example.com
# ACA_GENERAL_ACCESS_CODE=
# ACA_DEMO_ACCESS_LINK={{ACA_DEMO_DOMAIN}}/?code={{ACA_GENERAL_ACCESS_CODE}}
